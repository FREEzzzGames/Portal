[Unit]
Description=FREEzzz HUB Control Center
After=network.target

[Service]
Type=simple
User=freezzz-hub
Group=freezzz-hub
WorkingDirectory=/opt/freezzz-hub/app
Environment=PYTHONUNBUFFERED=1
Environment=FREEZZ_HUB_DOCKER_SOCKET=/var/run/docker.sock
ExecStart=/opt/freezzz-hub/venv/bin/uvicorn hub.main:app --host 127.0.0.1 --port 8787 --workers 1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/freezzz-hub

[Install]
WantedBy=multi-user.target
